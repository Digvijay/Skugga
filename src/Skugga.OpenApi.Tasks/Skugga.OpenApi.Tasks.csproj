<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--
      A symbol package would be empty here: IncludeBuildOutput is false because the assembly is
      packed into analyzers/ or tasks/ rather than lib/. Leaving the repo-wide IncludeSymbols=true
      in place made dotnet pack fail with NU5017 ("Cannot create a package that has no
      dependencies nor content"), which would have broken the CI pack step.
    -->
    <IncludeSymbols>false</IncludeSymbols>    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    
    <!-- Package metadata -->
    <PackageId>Skugga.OpenApi.Tasks</PackageId>
    <Version>1.6.0</Version>
    <Title>Skugga OpenAPI MSBuild Tasks</Title>
    <Description>MSBuild tasks for downloading OpenAPI specifications from URLs before source generation</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild SDK for writing tasks -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.0.0" PrivateAssets="all" />
    
    <!-- For async HTTP downloads -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <!-- Pack the task DLL and .targets file into the package -->
  <ItemGroup>
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="tasks/$(TargetFramework)" />
    <None Include="build/Skugga.OpenApi.Tasks.targets" Pack="true" PackagePath="build" />
    <None Include="buildTransitive/Skugga.OpenApi.Tasks.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
