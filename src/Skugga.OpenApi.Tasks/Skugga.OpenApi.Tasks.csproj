<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <!-- Not packed on its own. Skugga.Core.csproj packs this assembly into
         tasks/netstandard2.0 and its .targets into build/ and buildTransitive/
         inside the Skugga package, so a separate package would define the
         SkuggaDownloadOpenApiSpecs target a second time in any consumer that had
         both. It also carried no Version property, so it packed as 1.0.0 against
         the generator's 1.5.0, and like the generator it failed NU5017 with exit
         code 1 because IncludeBuildOutput=false leaves the symbol package empty. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    
    <!-- Package metadata -->
    <PackageId>Skugga.OpenApi.Tasks</PackageId>
    <Title>Skugga OpenAPI MSBuild Tasks</Title>
    <Description>MSBuild tasks for downloading OpenAPI specifications from URLs before source generation</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild SDK for writing tasks -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.10.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.10.1" PrivateAssets="all" />
    
    <!-- For async HTTP downloads -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <!-- Pack the task DLL and .targets file into the package -->
  <ItemGroup>
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="tasks/$(TargetFramework)" />
    <None Include="build/Skugga.OpenApi.Tasks.targets" Pack="true" PackagePath="build" />
    <None Include="buildTransitive/Skugga.OpenApi.Tasks.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
