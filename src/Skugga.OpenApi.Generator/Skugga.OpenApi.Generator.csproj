<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Not packed on its own. This generator ships inside the Skugga package:
         Skugga.Core.csproj packs this assembly into analyzers/dotnet/cs. Producing
         a second package carrying the same analyzer would load it twice in a
         consumer that referenced both. It also could not ship as-is: with
         IncludeBuildOutput=false the symbol package has no content, so `dotnet pack`
         failed NU5017 with exit code 1, which is why no Skugga.OpenApi package has
         ever been published despite five releases. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--
      A symbol package would be empty here: IncludeBuildOutput is false because the assembly is
      packed into analyzers/ or tasks/ rather than lib/. Leaving the repo-wide IncludeSymbols=true
      in place made dotnet pack fail with NU5017 ("Cannot create a package that has no
      dependencies nor content"), which would have broken the CI pack step.
    -->
    <IncludeSymbols>false</IncludeSymbols>    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Skugga.OpenApi</PackageId>
    <Version>1.6.0</Version>
    <Title>Skugga OpenAPI Source Generator</Title>
    <Description>Roslyn source generator for creating mocks from OpenAPI specifications. Automatically generates type-safe mocks with contract validation and example data support.</Description>
    <PackageTags>source-generator;roslyn;openapi;swagger;mocking;testing;skugga;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match Skugga.Generator's CodeAnalysis versions -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <!-- OpenApi.Readers 1.6.28: includes Microsoft.OpenApi 1.6.28 + SharpYaml 2.1.1 as dependencies -->
    <PackageReference Include="Microsoft.OpenApi.Readers" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi" GeneratePathProperty="true" PrivateAssets="all" />
    <!-- Override SharpYaml to latest 2.1.4 -->
    <PackageReference Include="SharpYaml" GeneratePathProperty="true" PrivateAssets="all" />
    <!-- System packages: Latest compatible with netstandard2.0 -->
    <PackageReference Include="System.Text.Json" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Text.Encodings.Web" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Memory" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Buffers" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>
  <!-- Include analyzer dependencies in output -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>
  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PKGMicrosoft_OpenApi_Readers)/lib/netstandard2.0/Microsoft.OpenApi.Readers.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGMicrosoft_OpenApi)/lib/netstandard2.0/Microsoft.OpenApi.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSharpYaml)/lib/netstandard2.0/SharpYaml.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSystem_Text_Json)/lib/netstandard2.0/System.Text.Json.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSystem_Text_Encodings_Web)/lib/netstandard2.0/System.Text.Encodings.Web.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSystem_Memory)/lib/netstandard2.0/System.Memory.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSystem_Buffers)/lib/netstandard2.0/System.Buffers.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(PKGSystem_Runtime_CompilerServices_Unsafe)/lib/netstandard2.0/System.Runtime.CompilerServices.Unsafe.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
  <!-- Package the generator and its dependencies as analyzers, and include MSBuild tasks dependency -->
  <ItemGroup>
    <!-- Pack the generator DLL as an analyzer -->
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    
    <!-- Pack all dependency DLLs -->
    <None Include="$(PKGMicrosoft_OpenApi_Readers)/lib/netstandard2.0/Microsoft.OpenApi.Readers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGMicrosoft_OpenApi)/lib/netstandard2.0/Microsoft.OpenApi.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSharpYaml)/lib/netstandard2.0/SharpYaml.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSystem_Text_Json)/lib/netstandard2.0/System.Text.Json.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSystem_Text_Encodings_Web)/lib/netstandard2.0/System.Text.Encodings.Web.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSystem_Memory)/lib/netstandard2.0/System.Memory.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSystem_Buffers)/lib/netstandard2.0/System.Buffers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGSystem_Runtime_CompilerServices_Unsafe)/lib/netstandard2.0/System.Runtime.CompilerServices.Unsafe.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    
    <!-- Include .props file for generator configuration -->
  </ItemGroup>

  <!-- Add dependency on Skugga.OpenApi.Tasks -->
  <ItemGroup>
    <!-- For local development, use ProjectReference -->
    <ProjectReference Include="../Skugga.OpenApi.Tasks/Skugga.OpenApi.Tasks.csproj" PrivateAssets="all" Condition="Exists('../Skugga.OpenApi.Tasks/Skugga.OpenApi.Tasks.csproj')" />
  </ItemGroup>

  <!-- Note: Users must install Skugga package separately as it's net8.0 and this is netstandard2.0 -->

</Project>
